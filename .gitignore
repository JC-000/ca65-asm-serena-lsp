# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
*.log

# Editors / OS
.DS_Store
.idea/
.vscode/

# Serena MCP local state (symlinks into the user's claude-code-rig dir)
.serena/

# Claude Code per-repo state (settings, plans, transcripts — managed by
# the user's claude-code-rig, not source code)
.claude/

# Build artifacts (CA65 toolchain)
*.o
*.bin
*.nes
*.prg
*.lst
*.map

# ...but keep committed test fixtures (regenerable via tools/regen_fixtures.sh)
!packages/ca65-ls/tests/fixtures/**/*.map
!packages/ca65-ls/tests/fixtures/**/*.lst
