#!/bin/sh
set -eu

# CLIENT-SIDE EMAIL ENFORCEMENT
# Substitute 3798556+JC-000@users.noreply.github.com with the literal email before installing.
target='3798556+JC-000@users.noreply.github.com'

extract_email() {
	# Input like: "Name <email> 1234567890 +0000" — pull what's between < and >
	printf '%s' "$1" | sed -n 's/.*<\([^>]*\)>.*/\1/p'
}

author_ident=$(git var GIT_AUTHOR_IDENT)
committer_ident=$(git var GIT_COMMITTER_IDENT)

author_email=$(extract_email "$author_ident")
committer_email=$(extract_email "$committer_ident")

if [ "$author_email" != "$target" ]; then
	printf "pre-commit: author email '%s' != required '%s' — check git config user.email\n" \
		"$author_email" "$target" >&2
	exit 1
fi

if [ "$committer_email" != "$target" ]; then
	printf "pre-commit: committer email '%s' != required '%s' — check git config user.email\n" \
		"$committer_email" "$target" >&2
	exit 1
fi

exit 0
